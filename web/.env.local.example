# Copy this file to .env.local and fill in the values from your AWS deployment.
# .env.local is gitignored — never commit real values.

# The deployed POST /watermark endpoint (from `./scripts/deploy.sh` output,
# the "ApiEndpoint" stack output).
WATERMARK_API_URL=https://z47zl0neyh.execute-api.eu-central-1.amazonaws.com/Prod/watermark

# The S3 bucket the Lambda reads from / writes to (the "BucketName" stack output).
WATERMARK_BUCKET=audio-watermark-audiobucket-mrzogtysyyzi

# AWS region the stack is deployed in.
AWS_REGION=eu-central-1

# API key for the endpoint. LEAVE BLANK until you deploy the Phase 4 template
# (API-key auth). When set, it is sent as the `x-api-key` header on embed calls.
WATERMARK_API_KEY=

# Recipient address put in the Lambda event. SES is in sandbox, so mail only
# actually sends to verified addresses — but email failure is non-fatal in the
# Lambda, so any valid-format address works for testing (the app fetches the
# result itself and does not rely on the email).
NOTIFY_EMAIL=test@example.com

# Python interpreter used for local watermark DETECTION (the deployed API does
# not detect). Point this at the project's virtualenv so numpy/scipy resolve.
# Relative paths are resolved from the repo root (the parent of web/).
PYTHON_BIN=../.venv/bin/python

# AWS credentials are read from the standard provider chain (the same
# ~/.aws/credentials / AWS_PROFILE your `aws` CLI already uses). You normally
# do NOT need to set keys here. To force a profile, uncomment:
# AWS_PROFILE=default
