# Copy this file to .env.local and fill in the values from your AWS deployment.
# .env.local is gitignored — never commit real values.

# The API base URL (from `./scripts/deploy.sh` output, the "ApiBaseUrl" stack output).
# Example: https://z47zl0neyh.execute-api.eu-central-1.amazonaws.com/Prod
WATERMARK_API_BASE_URL=https://z47zl0neyh.execute-api.eu-central-1.amazonaws.com/Prod

# The S3 bucket the Lambda reads from / writes to (the "BucketName" stack output).
WATERMARK_BUCKET=audio-watermark-audiobucket-mrzogtysyyzi

# AWS region the stack is deployed in.
AWS_REGION=eu-central-1

# API key for the endpoint. Required — retrieve with:
#   aws apigateway get-api-keys --include-values \
#     --query "items[?name=='WatermarkApiKey'].value" --output text
WATERMARK_API_KEY=

# Python interpreter used for local watermark DETECTION (the deployed API does
# not detect). Point this at the project's virtualenv so numpy/scipy resolve.
# Relative paths are resolved from the repo root (the parent of web/).
PYTHON_BIN=../.venv/bin/python

# AWS credentials are read from the standard provider chain (the same
# ~/.aws/credentials / AWS_PROFILE your `aws` CLI already uses). You normally
# do NOT need to set keys here. To force a profile, uncomment:
# AWS_PROFILE=default
